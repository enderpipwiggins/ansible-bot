# Copy this file to .env and fill in your values:  cp .env.example .env
# .env is gitignored — never commit real tokens.

# Twitch account the bot chats as (your own account or a dedicated bot account)
BOT_USERNAME=your_bot_username

# Chat OAuth token for BOT_USERNAME, with chat:read and chat:edit scopes.
# Format: oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_OAUTH=oauth:your_token_here

# Optional but recommended: refresh token printed alongside BOT_OAUTH.
# When set, the bot renews BOT_OAUTH automatically and saves the new
# BOT_OAUTH and BOT_REFRESH_TOKEN back into this file.
# Must come from the same app as TWITCH_CLIENT_ID.
# Uncomment and fill in to enable.
# BOT_REFRESH_TOKEN=your_refresh_token_here

# Comma-separated list of channels to join (no #)
CHANNELS=your_channel,another_channel

# Twitch app credentials from https://dev.twitch.tv/console/apps
# Used to fetch an app access token for the Helix API (auto-refreshed).
TWITCH_CLIENT_ID=your_client_id
TWITCH_CLIENT_SECRET=your_client_secret

# Optional: comma-separated usernames to never welcome.
# The bot account and joined channels are always skipped.
# Setting this replaces the default list, so keep the bots you still want skipped.
# SKIP_USERS=streamelements,streamlabs,nightbot,moobot,fossabot

# Optional: what the bot posts for a first-time streamer.
# Placeholders: {displayName} {login} {game} {title}
#
# Default (the bot writes the shoutout itself):
# WELCOME_MESSAGE=📡 Incoming transmission! Welcome {displayName} — last seen playing {game}: "{title}" → https://twitch.tv/{login}
#
# Or trigger your existing shoutout command (Streamlabs, StreamElements, Nightbot...).
# The bot account must be allowed to use the command (e.g. make it a mod).
# WELCOME_MESSAGE=!so {login}
